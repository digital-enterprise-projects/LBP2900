#!/bin/bash
#
# CUPS backend: print through a Windows host that owns the printer.
#
# The Canon LBP2900 speaks only CAPT and is attached by USB to a Windows PC.
# Nothing on this machine can render for it, so we hand the job to that PC and
# let its own driver do the work.
#
#   winbridge://<user>@<host>/<printer share name>
#
# CUPS calls a backend with no arguments to list devices, or with
#   argv[1]=job argv[2]=user argv[3]=title argv[4]=copies argv[5]=options [argv[6]=file]
# and the document on stdin when argv[6] is absent.

set -o pipefail

KEY=${WINBRIDGE_KEY:-/root/.ssh/id_ed25519}
SSH_OPTS="-i $KEY -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=20"
SUMATRA=${WINBRIDGE_SUMATRA:-C:\\Tools\\SumatraPDF\\SumatraPDF-3.5.2-64.exe}

# Device discovery: CUPS runs the backend with no arguments.
if [ $# -eq 0 ]; then
    echo 'network winbridge "Unknown" "Windows print bridge (SSH)"'
    exit 0
fi

if [ $# -lt 5 ] || [ $# -gt 6 ]; then
    echo "ERROR: winbridge: wrong argument count ($#)" >&2
    exit 1
fi

JOBID=$1
COPIES=$4
FILE=$6

# DEVICE_URI is winbridge://user@host/printer%20name
URI=${DEVICE_URI#winbridge://}
CRED=${URI%%/*}
SHARE=${URI#*/}
# CUPS strips the user from the stored URI, so fall back to a default.
case $CRED in
    *@*) USERHOST=$CRED ;;
    *)   USERHOST=${WINBRIDGE_USER:-Admin}@$CRED ;;
esac
# Percent-decode the printer name.
PRINTER=$(printf '%b' "${SHARE//%/\\x}")

if [ -z "$USERHOST" ] || [ -z "$PRINTER" ]; then
    echo "ERROR: winbridge: bad device URI '$DEVICE_URI'" >&2
    exit 1
fi

echo "INFO: winbridge: sending job $JOBID to $PRINTER on $USERHOST" >&2

LOCAL=$(mktemp /tmp/winbridge-XXXXXX.pdf) || exit 1
trap 'rm -f "$LOCAL"' EXIT

if [ -n "$FILE" ]; then
    cp "$FILE" "$LOCAL" || { echo "ERROR: winbridge: cannot read $FILE" >&2; exit 1; }
else
    cat > "$LOCAL" || { echo "ERROR: winbridge: cannot read job from stdin" >&2; exit 1; }
fi

if [ ! -s "$LOCAL" ]; then
    echo "ERROR: winbridge: job is empty" >&2
    exit 1
fi

REMOTE="C:\\Windows\\Temp\\winbridge-${JOBID}.pdf"
REMOTE_SCP="C:/Windows/Temp/winbridge-${JOBID}.pdf"

echo "INFO: winbridge: copying $(stat -c%s "$LOCAL") bytes" >&2
if ! scp $SSH_OPTS -q "$LOCAL" "${USERHOST}:${REMOTE_SCP}"; then
    echo "ERROR: winbridge: cannot copy the job to $USERHOST" >&2
    exit 1
fi

STATUS=0
for i in $(seq 1 "${COPIES:-1}"); do
    echo "INFO: winbridge: printing copy $i of ${COPIES:-1}" >&2
    if ! ssh $SSH_OPTS "$USERHOST" \
        "\"$SUMATRA\" -print-to \"$PRINTER\" -silent -exit-when-done \"$REMOTE\""; then
        echo "ERROR: winbridge: the Windows host refused the job" >&2
        STATUS=1
        break
    fi
done

# Always clean up the spooled copy, even when printing failed.
ssh $SSH_OPTS "$USERHOST" "del /q \"$REMOTE\"" >/dev/null 2>&1

# Jobs submitted from a headless SSH session never get marked complete by the
# spooler: the paper comes out but the queue entry sits in Printing/Retained
# forever and blocks the next job. Give the spooler a moment, then remove the
# finished entry for our document. base64-encoded to survive three layers of
# quoting (bash -> ssh -> powershell).
if [ $STATUS -eq 0 ]; then
    echo "INFO: winbridge: clearing the retained queue entry" >&2
    sleep 20
    PSCMD="Get-PrintJob -PrinterName '$PRINTER' -ErrorAction SilentlyContinue | Where-Object { \$_.DocumentName -like '*winbridge-${JOBID}.pdf' } | ForEach-Object { Remove-PrintJob -PrinterName '$PRINTER' -ID \$_.Id }"
    ENC=$(printf "%s" "$PSCMD" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
    ssh $SSH_OPTS "$USERHOST" "powershell -NoProfile -EncodedCommand $ENC" >/dev/null 2>&1 || true
fi

if [ $STATUS -eq 0 ]; then
    echo "INFO: winbridge: job $JOBID handed over" >&2
fi
exit $STATUS
