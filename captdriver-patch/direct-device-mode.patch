 #include <cups/cups.h>
 #include <cups/sidechannel.h>
 
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
 static uint8_t capt_iobuf[0x10000];
 static size_t  capt_iosize;
 
+/*
+ * Direct device mode.
+ *
+ * The CUPS back channel never delivers the printer's replies on some
+ * host/backend combinations, so the very first CAPT command times out and the
+ * driver gives up. The printer itself answers fine over the usblp character
+ * device, so when one is available we bypass the CUPS channels entirely and
+ * do our own reads and writes. Set CAPT_DEVICE to override the path, or
+ * CAPT_DEVICE="" to force the original CUPS channels.
+ */
+
+#ifndef LPIOC_GET_DEVICE_ID
+#define LPIOC_GET_DEVICE_ID(len) _IOC(_IOC_READ, 'P', 1, len)
+#endif
+
+static int capt_fd = -2; /* -2 not tried yet, -1 unavailable */
+
+static int capt_direct(void)
+{
+	if (capt_fd == -2) {
+		const char *dev = getenv("CAPT_DEVICE");
+		if (!dev)
+			dev = "/dev/usb/lp0";
+		if (!*dev) {
+			capt_fd = -1;
+			fprintf(stderr, "DEBUG: CAPT: direct mode disabled\n");
+			return capt_fd;
+		}
+		capt_fd = open(dev, O_RDWR);
+		if (capt_fd < 0)
+			fprintf(stderr, "DEBUG: CAPT: no direct device %s (%s), "
+					"falling back to CUPS channels\n", dev, strerror(errno));
+		else
+			fprintf(stderr, "DEBUG: CAPT: talking directly to %s\n", dev);
+	}
+	return capt_fd;
+}
+
+static ssize_t capt_direct_read(void *buf, size_t expected, int timeout_ms)
+{
+	int fd = capt_direct();
+	size_t got = 0;
+	while (got < expected) {
+		struct pollfd pfd;
+		ssize_t n;
+		pfd.fd = fd;
+		pfd.events = POLLIN;
+		pfd.revents = 0;
+		if (poll(&pfd, 1, timeout_ms) <= 0)
+			break;
+		n = read(fd, (char *) buf + got, expected - got);
+		if (n <= 0)
+			break;
+		got += (size_t) n;
+	}
+	return (ssize_t) got;
+}
+
+static int capt_direct_write(const void *buf, size_t size)
+{
+	int fd = capt_direct();
+	const char *p = buf;
+	while (size > 0) {
+		ssize_t n = write(fd, p, size);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		p += n;
+		size -= (size_t) n;
+	}
+	return 0;
+}
